<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: connect button, status and server name, and
     arrows to step through the saved configurations. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="4dp">

    <ImageButton
        android:id="@+id/widget_toggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_btn_off"
        android:contentDescription="@string/widget_toggle"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_power" />

    <LinearLayout
        android:id="@+id/widget_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFE8ECF5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF98A2B8"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_prev"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/widget_prev"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_prev" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/widget_next"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_next" />
</LinearLayout>
